# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App ---
ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (you said you've already provisioned this — point it at your DB) ---
DATABASE_URL=postgresql+psycopg://adpilot:adpilot@localhost:5432/adpilot

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM: Gemini Flash (free tier) is primary, Groq is automatic fallback ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.1:8b
LLM_TIMEOUT_SECONDS=60

# --- Meta / Facebook Marketing API ---
# Get these from developers.facebook.com after completing the Meta setup
# prerequisites in the design doc (§9) — you said this part is already done.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/meta/oauth/callback
# Dev-only: System User token for YOUR OWN ad account (Milestone 1-2 testing).
# Never use this for client accounts — see design doc §7.1.
META_SYSTEM_USER_TOKEN=

# --- Token encryption ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Budget Guard hard ceilings (design doc §6 — change with real caution) ---
MAX_DAILY_BUDGET_INR=5000
MAX_CAMPAIGN_LIFETIME_INR=50000

# --- Sentry (optional) ---
SENTRY_DSN=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
